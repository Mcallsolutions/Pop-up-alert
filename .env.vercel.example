# Variaveis de ambiente do projeto na Vercel
# (Project Settings -> Environment Variables).
#
# ATENCAO: este arquivo e um MODELO e esta versionado no git. Nada aqui e lido
# em tempo de execucao — nem local (o dotenv carrega apenas .env) nem na Vercel,
# que le os valores do painel do projeto. Preencha os valores reais SOMENTE no
# painel da Vercel; deixe este arquivo apenas com os marcadores abaixo.

NODE_ENV=production

# Se voce conectou o Vercel Postgres / Neon pela aba Storage, as variaveis
# POSTGRES_URL e DATABASE_URL ja sao injetadas automaticamente e voce NAO
# precisa definir nada aqui.
# Para um Postgres externo (Supabase, Railway, etc.), preencha manualmente:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h

# A senha do painel vem daqui e nao tem tela para troca-la. Alterar
# ADMIN_PASSWORD na Vercel e redeployar ja atualiza o admin existente.
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Opcional. Se preenchido, a extensao precisa enviar o mesmo valor no header x-extension-token.
EXTENSION_TOKEN=troque-por-um-token-longo-e-aleatorio

# Integracao com a OpenAI (aba IA do painel). A chave e usada SOMENTE no
# servidor; o navegador nunca a recebe. Sem ela o painel funciona normalmente e
# apenas a geracao de resumo fica bloqueada.
OPENAI_API_KEY=sk-troque-pela-chave-real
OPENAI_MODEL=gpt-4o-mini
# Opcionais: OPENAI_BASE_URL, OPENAI_ORGANIZATION, OPENAI_PROJECT,
# OPENAI_TEMPERATURE, OPENAI_MAX_OUTPUT_TOKENS, OPENAI_TIMEOUT_MS.
# O timeout precisa ficar abaixo do maxDuration de 30s definido em vercel.json.

# O painel roda na mesma origem da API, entao aqui basta liberar a extensao.
# Troque ID_DA_EXTENSAO pelo ID real mostrado em chrome://extensions.
CORS_ORIGINS=chrome-extension://bjilcelammiiiloegdimkinejlmplofa,https://pop-up-alert.vercel.app/


# Nao defina VITE_API_URL: vazio faz o painel chamar a API na propria origem.
