# Variaveis de ambiente do projeto na Vercel
# (Project Settings -> Environment Variables). NAO faca commit do .env real.

NODE_ENV=production

# Se voce conectou o Vercel Postgres / Neon pela aba Storage, as variaveis
# POSTGRES_URL e DATABASE_URL ja sao injetadas automaticamente e voce NAO
# precisa definir nada aqui. A API detecta e usa PostgreSQL sozinha.
# Para um Postgres externo (Supabase, Railway, etc.), preencha manualmente:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=admin@mcall
ADMIN_NAME=Administrador
ADMIN_PASSWORD=NiggX53@

# Opcional. Se preenchido, a extensao precisa enviar o mesmo valor no header x-extension-token.
EXTENSION_TOKEN=troque-por-um-token-longo-e-aleatorio

# O painel roda na mesma origem da API, entao aqui basta liberar a extensao.
# Troque ID_DA_EXTENSAO pelo ID real mostrado em chrome://extensions.
CORS_ORIGINS=chrome-extension://bjilcelammiiiloegdimkinejlmplofa,https://pop-up-alert.vercel.app/


# Nao defina VITE_API_URL: vazio faz o painel chamar a API na propria origem.
