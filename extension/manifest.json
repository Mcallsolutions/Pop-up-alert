{
  "manifest_version": 3,
  "name": "Mcall Ticket Tag Monitor",
  "description": "Mostra na tela de tickets do MTalk os alertas de TAG e de inatividade calculados pela API local.",
  "version": "0.1.0",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Mcall Ticket Tag Monitor",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://s11.mtalk.com.br/*",
    "http://localhost:3333/*",
    "http://127.0.0.1:3333/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://s11.mtalk.com.br/tickets*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
