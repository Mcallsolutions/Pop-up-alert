{
  "manifest_version": 3,
  "name": "Mcall Ticket Tag Monitor",
  "description": "Monitora tickets do MTalk e alerta quando a TAG do cliente nao foi registrada.",
  "version": "0.0.1",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Mcall Ticket Tag Monitor",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://s11.mtalk.com.br/tickets*",
    "http://localhost:3333/*",
    "https://pop-up-alert.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://s11.mtalk.com.br/tickets*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
