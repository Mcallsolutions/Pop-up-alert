# Ambiente LOCAL. Copie para .env na raiz do projeto.
NODE_ENV=development
PORT=3333

# A API usa PostgreSQL. Aponte para um banco proprio (Neon, Supabase, Docker
# local, etc.). Na Vercel esta variavel e injetada pela integracao de Storage.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mcall

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=admin@mcall.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=admin123

# Opcional. Se preenchido, a extensao precisa enviar o mesmo valor no header x-extension-token.
EXTENSION_TOKEN=

# Integracao com a API oficial do MTalk.
# A extensao le os tickets pela API usando a sessao aberta no painel e nao
# precisa de nenhuma variavel aqui. As de baixo servem so para a coleta
# headless (POST /api/mtalk/collect), que roda sem navegador.
MTALK_BASE_URL=https://s11.mtalk.com.br/backend
# Token Bearer de um usuario do MTalk (o mesmo de localStorage["token"] no
# painel). Expira junto com a sessao, entao precisa ser renovado de tempos em
# tempos. Sem ele, /api/mtalk/collect responde 503.
MTALK_TOKEN=
# Opcionais: so preencha para mudar o padrao.
# MTALK_TICKET_STATUSES=open,pending
# MTALK_PAGE_SIZE=40
# MTALK_MAX_PAGES=5
# MTALK_QUEUE_CACHE_MINUTES=10
# MTALK_TIMEOUT_MS=12000
# Minutos sem atividade para um ticket entrar no alerta de inatividade.
# INACTIVITY_THRESHOLD_MINUTES=15
# Segredo dos Cron Jobs da Vercel, aceito por /api/mtalk/collect no header
# Authorization: Bearer <valor>.
# CRON_SECRET=

# Integracao com a OpenAI (resumos da aba IA). Sem a chave, o painel continua
# funcionando e apenas o botao "Gerar resumo com IA" fica bloqueado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcionais: so preencha para mudar o padrao.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# OPENAI_TEMPERATURE=0.2
# OPENAI_MAX_OUTPUT_TOKENS=1200
# OPENAI_TIMEOUT_MS=25000

# Separe origens por virgula. Extensoes Chrome usam origem chrome-extension://<id>.
CORS_ORIGINS=http://localhost:5173,chrome-extension://bjilcelammiiiloegdimkinejlmplofa
