# Ambiente LOCAL. Copie para .env na raiz do projeto.
# O .env esta no .gitignore: credenciais reais nunca vao para o repositorio.
PORT=3333

# Interface onde a API escuta. Padrao 0.0.0.0 (alcancavel na rede local, que e
# como a extensao de cada atendente chega ate ela). Na VPS, com nginx na frente,
# use 127.0.0.1: so o nginx fala com o Node e a porta 3333 some da internet.
# HOST=0.0.0.0

# 1 quando houver proxy (nginx) na frente: o Express passa a ler o IP real do
# X-Forwarded-For, que e o que o rate limit usa. Sem proxy, deixe 0.
# TRUST_PROXY=0

# A API serve o painel compilado (/dist) quando ele existe. SERVE_ADMIN=0
# desliga, para o nginx servir os estaticos sozinho.
# SERVE_ADMIN=1

# Banco SQLite local (arquivo criado sozinho na primeira execucao).
# SQLITE_PATH=server/data/monitor.sqlite

# Integracao com a API oficial do MTalk: URL da instancia (com ou sem
# "/backend") e token Bearer de um usuario com acesso as filas monitoradas.
# O servidor nao renova o token: quando o MTalk recusar, gere um novo, atualize
# aqui e reinicie a API.
MTALK_BASE_URL=https://s11.mtalk.com.br/backend
MTALK_TOKEN=

# Opcionais: so preencha para mudar o padrao.
# Intervalo da coleta automatica em segundos (0 desliga; sobra o botao "Coletar agora").
# MTALK_COLLECT_INTERVAL_SECONDS=60
# MTALK_TICKET_STATUSES=open,pending
# MTALK_PAGE_SIZE=40
# MTALK_MAX_PAGES=5
# MTALK_QUEUE_CACHE_MINUTES=60
# Cache do catalogo GET /backend/tags/list, que so e lido quando um vinculo de
# TAG chega sem o nome.
# MTALK_TAG_CACHE_MINUTES=10
# Consultas NOVAS a GET /backend/contacts/{id} por coleta, usadas para descobrir
# a TAG vinculada ao CLIENTE quando a listagem de tickets nao a devolve. 0 desliga.
# MTALK_MAX_CONTACT_LOOKUPS=20
# MTALK_TIMEOUT_MS=12000
# Minutos sem atividade para um ticket entrar no alerta de inatividade.
# INACTIVITY_THRESHOLD_MINUTES=15
# Dias de historico de coletas guardados no banco (0 guarda tudo). Cada coleta
# grava de novo todos os tickets em atendimento, entao sem limite o banco so cresce.
# RETENTION_DAYS=90
# Fuso da operacao: define o "dia" dos filtros e o horario exibido.
# MONITOR_TIME_ZONE=America/Sao_Paulo

# Integracao com a OpenAI (resumos da aba IA). Sem a chave, o painel continua
# funcionando e apenas o botao "Gerar resumo com IA" fica bloqueado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcionais: OPENAI_BASE_URL, OPENAI_ORGANIZATION, OPENAI_PROJECT,
# OPENAI_TEMPERATURE (0.2), OPENAI_MAX_OUTPUT_TOKENS (2000), OPENAI_TIMEOUT_MS (25000).

# Analise de atendimento por IA (pagina "Atendimento IA"). Desligada por padrao:
# com 0 nada muda — nenhuma chamada a /messages no MTalk e nenhuma mensagem
# gravada. Com 1, o servidor le as conversas, MASCARA os dados pessoais antes
# de gravar e pede a OpenAI uma avaliacao de cada atendimento. Antes de ligar,
# faca o checklist de "Mtalk integration/README.md" com um ticket de teste.
AI_ATTENDANCE_ANALYSIS=0
# Teto de GET /messages/{ticketId} por coleta (0 para de ler mensagens novas).
# MTALK_MAX_MESSAGE_FETCHES=20
# Dias que as mensagens mascaradas ficam no banco. 0 NAO desliga (vale o padrao).
# MESSAGE_RETENTION_DAYS=30
# Minutos de conversa parada para ela entrar na fila da IA (ticket fechado entra na hora).
# AI_ANALYSIS_IDLE_MINUTES=20
# Minimo de mensagens novas para analisar (com 1+ do cliente e 1+ humana da empresa).
# AI_ANALYSIS_MIN_MESSAGES=4
# Maximo de mensagens por analise; passando disso, ficam as mais recentes.
# AI_ANALYSIS_MAX_MESSAGES=80
# Teto de chamadas a OpenAI por hora na analise automatica (0 pausa; o botao do painel continua).
# AI_ANALYSIS_MAX_PER_HOUR=30
# Modelo so desta analise. Vazio usa OPENAI_MODEL.
# AI_ANALYSIS_MODEL=

# Origens liberadas no CORS, separadas por virgula. O padrao ja cobre o painel
# em dev (localhost:5173) e qualquer extensao Chrome.
# CORS_ORIGINS=http://localhost:5173,chrome-extension://
# Hospedado:
# CORS_ORIGINS=https://tag-monitor.mcallsolutions.com.br,chrome-extension://

# Horas que o login do painel vale antes de pedir usuario e senha de novo.
# ADMIN_SESSION_HOURS=12

# Modo aberto da extensao, SO para desenvolvimento: com 1 e nenhum token de
# extensao ativo, as rotas /api/mtalk ficam abertas e todo mundo ve todos os
# alertas. Sem a variavel (como na VPS), sem token a extensao recebe 401.
EXTENSION_OPEN_MODE=1
