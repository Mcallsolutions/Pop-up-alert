# Ambiente LOCAL. Copie para .env na raiz do projeto.
NODE_ENV=development
PORT=3333

# Local usa SQLite. Na Vercel isso e ignorado: se existir DATABASE_URL/POSTGRES_URL,
# a API usa PostgreSQL automaticamente.
DATABASE_CLIENT=sqlite
SQLITE_DATABASE=./server/data/mcall.sqlite

# Para usar Postgres tambem no local, basta preencher:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=admin@mcall.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=admin123

# Opcional. Se preenchido, a extensao precisa enviar o mesmo valor no header x-extension-token.
EXTENSION_TOKEN=

# Separe origens por virgula. Extensoes Chrome usam origem chrome-extension://<id>.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,chrome-extension://
