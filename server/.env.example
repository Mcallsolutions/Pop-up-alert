NODE_ENV=development
PORT=3333

DATABASE_CLIENT=sqlite
SQLITE_DATABASE=./data/mcall.sqlite
DATABASE_URL=

JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=admin@mcall.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=admin123

# Opcional. Se preenchido, a extensao precisa enviar o mesmo valor no header x-extension-token.
EXTENSION_TOKEN=

# Separe origens por virgula. Extensoes Chrome usam origem chrome-extension://<id>.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,chrome-extension://

