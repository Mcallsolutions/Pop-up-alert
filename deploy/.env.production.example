# Modelo do .env da VPS. Copie para /opt/tag-monitor/.env, preencha os tokens e
# proteja o arquivo:
#
#   sudo chown tag-monitor:tag-monitor /opt/tag-monitor/.env && sudo chmod 600 /opt/tag-monitor/.env

PORT=3333
# So o nginx fala com o Node.
HOST=127.0.0.1
# Ha proxy na frente: le o IP real do X-Forwarded-For.
TRUST_PROXY=1
# O nginx serve /opt/tag-monitor/dist; o Node cuida so da API.
SERVE_ADMIN=0

# Fora da pasta do deploy, para o `git pull` nunca encostar no banco.
SQLITE_PATH=/var/lib/tag-monitor/monitor.sqlite

MTALK_BASE_URL=https://s11.mtalk.com.br/backend
MTALK_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MONITOR_TIME_ZONE=America/Sao_Paulo

# Dominio em ASCII (punycode): e assim que o navegador manda o Origin.
CORS_ORIGINS=https://tag-monitor.mcallsolutions.com.br,chrome-extension://

# Horas que o login do painel vale antes de pedir usuario e senha de novo.
# ADMIN_SESSION_HOURS=12

# Dias de historico de coletas no banco (padrao 90; 0 guarda tudo).
# RETENTION_DAYS=90

# Analise de atendimento por IA. Desligada: nenhuma chamada a /messages no MTalk e
# nenhuma mensagem gravada. Com 1, as conversas sao lidas, MASCARADAS antes de
# gravar e avaliadas pela OpenAI. So ligue depois do checklist de
# "Mtalk integration/README.md", feito com um ticket de teste.
AI_ATTENDANCE_ANALYSIS=0
# Teto de GET /messages/{ticketId} por coleta (0 para de ler mensagens novas).
# MTALK_MAX_MESSAGE_FETCHES=20
# Dias que as mensagens mascaradas ficam no banco. 0 NAO desliga (vale o padrao).
# MESSAGE_RETENTION_DAYS=30
# Minutos de conversa parada para ela entrar na fila da IA (ticket fechado entra na hora).
# AI_ANALYSIS_IDLE_MINUTES=20
# Minimo de mensagens novas para analisar (com 1+ do cliente e 1+ humana da empresa).
# AI_ANALYSIS_MIN_MESSAGES=4
# Maximo de mensagens por analise; passando disso, ficam as mais recentes.
# AI_ANALYSIS_MAX_MESSAGES=80
# Teto de chamadas a OpenAI por hora na analise automatica (0 pausa; o botao do painel continua).
# AI_ANALYSIS_MAX_PER_HOUR=30
# Modelo so desta analise. Vazio usa OPENAI_MODEL.
# AI_ANALYSIS_MODEL=

# NUNCA defina EXTENSION_OPEN_MODE aqui: sem ela, extensao sem token recebe 401
# em vez de todo mundo ver todos os alertas.
