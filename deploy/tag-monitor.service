# systemd unit da API. Copie para /etc/systemd/system/tag-monitor.service e ajuste os
# caminhos se o deploy nao estiver em /opt/tag-monitor.
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tag-monitor

[Unit]
Description=Mcall Ticket Tag API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tag-monitor
Group=tag-monitor
WorkingDirectory=/opt/tag-monitor
EnvironmentFile=/opt/tag-monitor/.env
ExecStart=/usr/bin/node server/src/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# O processo so escreve no banco: o resto do disco fica somente leitura.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tag-monitor

[Install]
WantedBy=multi-user.target
